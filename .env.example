# Copy this file to .env and fill in your values.
# Never commit .env — it's in .gitignore.

# A random string, at least 32 characters long.
Jwt__Secret=change-me-to-a-random-string-at-least-32-chars-long

# Bcrypt hash (cost 11) of your admin password.
# Generate one at: https://bcrypt-generator.com
Admin__PasswordHash=$2a$11$REPLACE_WITH_BCRYPT_HASH_OF_YOUR_PASSWORD
